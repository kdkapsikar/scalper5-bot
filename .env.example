# Copy to .env (never commit .env). Telegram is optional; without it alerts print to the console/log.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Upstox (stocks, indices, MCX). Tokens expire daily: run scripts/upstox_token.py each morning.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=
# Optional: paste a token here instead of using scripts/upstox_token.py (the token file wins if both exist)
UPSTOX_ACCESS_TOKEN=

# --- CoinSwitch PRO (crypto futures). Use a key restricted to your server IP, with no withdrawal rights if possible.
COINSWITCH_API_KEY=
COINSWITCH_SECRET_KEY=

# --- OANDA (optional: XAUUSD (OANDA) for the command-line tools). A practice (demo) account token works.
OANDA_API_TOKEN=
OANDA_ENV=practice

# Optional bot defaults
# SCALP_WATCHLIST=watchlist.yaml

# --- Portal accounts (the web portal; the CLI tools ignore these)
# DATABASE_URL=            # empty = SQLite in .state/portal.db. Hosted: a Postgres URL (see .streamlit/secrets.toml.example)
# SCALP_MASTER_KEY=        # empty locally = .state/master.key is created. Required with a remote database.
# ADMIN_EMAILS=you@example.com
# PORTAL_URL=http://localhost:8501/
