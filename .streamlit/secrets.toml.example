# Streamlit Community Cloud: paste these into your app's Settings > Secrets (never commit real values).
# Root-level secrets are also exposed as environment variables, which is how the portal reads them.

# Hosted Postgres (Neon or Supabase free tier). Community Cloud has no lasting disk, so SQLite would be wiped.
DATABASE_URL = "postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Encrypts everyone's broker keys. Generate once with:  python -m scalpbot.accounts --new-master-key
# Keep a copy somewhere safe: if it is lost, every user has to re-enter their keys.
SCALP_MASTER_KEY = ""

# Comma-separated emails that become admins when they sign up.
ADMIN_EMAILS = "you@example.com"

# The app's public address. Users register it as the redirect URI on their Upstox developer app.
PORTAL_URL = "https://your-app-name.streamlit.app/"

# Hides the local-only Alert bot page (auto-detected when DATABASE_URL is not SQLite).
SCALP_HOSTED = "1"
